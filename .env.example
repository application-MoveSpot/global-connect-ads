# =============================================================================
# MoveSpot — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne jamais commiter .env.local ni .env avec de vraies valeurs
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (obligatoires)
# Dashboard → Settings → API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...          # anon/public key

# Alias serveur (Cloudflare Workers / TanStack Start SSR)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...               # anon/public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # service role — ne jamais exposer côté client

# -----------------------------------------------------------------------------
# Stripe (paiements)
# Dashboard → Developers → API keys
# Utiliser VITE_PAYMENTS_CLIENT_TOKEN via l'intégration Lovable, pas STRIPE_SECRET_KEY
# -----------------------------------------------------------------------------
VITE_PAYMENTS_CLIENT_TOKEN=pk_live_...        # clé publique Stripe (Lovable)
STRIPE_PUBLISHABLE_KEY=pk_live_...            # clé publique Stripe (SSR)
STRIPE_SECRET_KEY=sk_live_...                 # clé secrète — serveur uniquement
SUPABASE_WEBHOOK_SECRET=whsec_...             # secret webhook Stripe → Supabase

# -----------------------------------------------------------------------------
# IA / Chatbot FAQ
# Lovable Dashboard → Secrets
# -----------------------------------------------------------------------------
LOVABLE_API_KEY=...                           # clé API Lovable AI Gateway

# -----------------------------------------------------------------------------
# Web Push (notifications)
# Générer avec: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=BN...                        # clé publique VAPID (safe côté client)
VITE_VAPID_PUBLIC_KEY=BN...                   # même valeur, exposée au navigateur
VAPID_PRIVATE_KEY=...                         # clé privée — serveur uniquement
VAPID_SUBJECT=mailto:contact@move-spot.com    # contact pour les push

# -----------------------------------------------------------------------------
# Emails (Supabase Edge Functions)
# resend.com → API Keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...

# -----------------------------------------------------------------------------
# Pixel retargeting (optionnel — laisser vide pour désactiver)
# Meta Pixel : Ads Manager → Events Manager → votre pixel → Settings → Pixel ID
# Google Ads : ads.google.com → Outils → Suivi des conversions → Balise → ID
# -----------------------------------------------------------------------------
VITE_META_PIXEL_ID=                            # ex: 1234567890123456
VITE_GADS_ID=                                  # ex: AW-123456789
VITE_GADS_REGISTRATION_LABEL=                  # ex: AbCdEfGhIjK (label conversion inscription)

# -----------------------------------------------------------------------------
# Sécurité / Cron
# -----------------------------------------------------------------------------
CRON_SECRET=...                               # secret partagé entre pg_cron et enforce-cron
ADMIN_SETUP_TOKEN=...                         # token one-shot setup admin (désactiver après usage)

# -----------------------------------------------------------------------------
# Virement bancaire (espace admin — coordonnées MoveSpot)
# -----------------------------------------------------------------------------
CA_IBAN=FR76...
CA_BIC=...
CA_ACCOUNT_HOLDER=RAKOUN KLUB

# -----------------------------------------------------------------------------
# Sentry (monitoring erreurs)
# sentry.io → Project → Settings → Client Keys (DSN)
# sentry.io → Settings → Auth Tokens (SENTRY_AUTH_TOKEN)
# sentry.io → Settings → General (SENTRY_ORG = slug de l'organisation)
# sentry.io → Project → Settings → General (SENTRY_PROJECT = slug du projet)
# -----------------------------------------------------------------------------
VITE_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...   # upload des source maps (Lovable Dashboard → Secrets)
SENTRY_ORG=move-spot           # slug de l'organisation Sentry
SENTRY_PROJECT=move-spot-web   # slug du projet Sentry

# -----------------------------------------------------------------------------
# Divers
# -----------------------------------------------------------------------------
VITE_STATUS_MESSAGE=                          # message bannière statut (vide = pas de bannière)
VITE_APP_VERSION=1.0.0
NODE_ENV=production
